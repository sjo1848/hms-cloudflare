await ((page) => (async () => {
  await page.addInitScript(() => {
    localStorage.setItem("hms.locale", "en");
    localStorage.setItem("hms-local-acceptance-profile", "1");
  });
  await page.setViewportSize({ width: 1280, height: 900 });
  const offsetDate = days => {
    const date = new Date();
    date.setUTCDate(date.getUTCDate() + days);
    return date.toISOString().slice(0, 10);
  };
  const start = offsetDate(10);
  const end = offsetDate(12);
  await page.goto("http://127.0.0.1:4176/bookings");
  await page.getByRole("heading", { name: "Booking case workspace" }).waitFor();
  await page.getByRole("button", { name: "Create booking" }).click();
  const form = page.locator("form[aria-label='Create booking']");
  await form.locator("input[type=checkbox]").check();
  await form.getByLabel("Full name").fill("F0.8 Integrated Guest");
  await form.getByLabel("Guest email").fill("f08-integrated@example.test");
  await form.locator("input[type=date]").nth(0).fill(start);
  await form.locator("input[type=date]").nth(1).fill(end);
  const initialAvailability = page.waitForResponse(response => response.url().includes("/api/v1/rooms/available"));
  await form.getByRole("button", { name: "Find available rooms" }).click();
  const initialRooms = await (await initialAvailability).json();
  if (!initialRooms.some(room => room.id === "e2e-room-a")) throw new Error(`expected destination absent from authoritative availability response: ${JSON.stringify(initialRooms)}`);
  await form.getByLabel("Room").selectOption("e2e-room-a");
  const createResponse = page.waitForResponse(response => response.url().endsWith("/api/v1/reservation-creation-operations") && response.request().method() === "POST");
  const createQueueRefresh = page.waitForResponse(response => response.url().endsWith("/api/v1/front-desk/board") && response.request().method() === "GET");
  await form.getByRole("button", { name: "Create booking" }).click();
  const successfulResponse = await createResponse;
  if (successfulResponse.status() !== 201) throw new Error(`new guest booking returned ${successfulResponse.status()}: ${await successfulResponse.text()}`);
  await createQueueRefresh;
  const created = await successfulResponse.json();
  if (created.operation.stage !== "BOOKING_CREATED" || created.booking.total_cents !== 20000) throw new Error(`unexpected persisted create result ${JSON.stringify(created)}`);
  const createdReload = await page.evaluate(async bookingId => {
    const response = await fetch(`/api/v1/bookings/${bookingId}`, { headers: {
      "x-local-access-subject": "source-user:14000000-0000-0000-0000-000000000002",
      "x-local-access-email": "leo-reception@migration.invalid",
      "x-hotel-id": "10000000-0000-0000-0000-000000000001",
    } });
    return { status: response.status, booking: await response.json() };
  }, created.booking.id);
  if (createdReload.status !== 200 || createdReload.booking.id !== created.booking.id) throw new Error(`authoritative booking reload failed: ${JSON.stringify(createdReload)}`);

  const recoveryStart = offsetDate(20);
  const recoveryEnd = offsetDate(22);
  const staged = await page.evaluate(async ({ recoveryStart, recoveryEnd }) => {
    const token = crypto.randomUUID();
    const response = await fetch("/api/v1/reservation-creation-operations", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-local-access-subject": "source-user:14000000-0000-0000-0000-000000000002",
        "x-local-access-email": "leo-reception@migration.invalid",
        "x-hotel-id": "10000000-0000-0000-0000-000000000001",
      },
      body: JSON.stringify({
        operation_token: token,
        guest: { full_name: "F0.8 Recovery Guest", email: "f08-recovery@example.test" },
        booking: { room_id: "e2e-room-blocked", check_in: recoveryStart, check_out: recoveryEnd, notes: "recovery after conflict" },
      }),
    });
    return { token, status: response.status, body: await response.json() };
  }, { recoveryStart, recoveryEnd });
  if (staged.status !== 409 || staged.body.operation?.stage !== "GUEST_CREATED") throw new Error(`expected durable recoverable guest stage, got ${JSON.stringify(staged)}`);

  await page.reload();
  await page.getByRole("heading", { name: "Booking case workspace" }).waitFor();
  await page.getByRole("button", { name: "Create booking" }).click();
  const recoveryItem = page.locator(".reception-recovery-item").filter({ hasText: "F0.8 Recovery Guest" });
  await recoveryItem.waitFor();
  await recoveryItem.getByRole("button", { name: "Use saved guest" }).click();
  const resumedForm = page.locator("form[aria-label='Create booking']");
  const resumedAvailability = page.waitForResponse(response => response.url().includes("/api/v1/rooms/available"));
  await resumedForm.getByRole("button", { name: "Find available rooms" }).click();
  const resumedRooms = await (await resumedAvailability).json();
  if (!resumedRooms.some(room => room.id === "e2e-room-b")) throw new Error(`recovery destination absent from authoritative availability response: ${JSON.stringify(resumedRooms)}`);
  await resumedForm.getByLabel("Room").selectOption("e2e-room-b");
  const retryResponse = page.waitForResponse(response => response.url().endsWith("/api/v1/reservation-creation-operations") && response.request().method() === "POST");
  const recoveryQueueRefresh = page.waitForResponse(response => response.url().endsWith("/api/v1/front-desk/board") && response.request().method() === "GET");
  const recoveryListRefresh = page.waitForResponse(response => response.url().endsWith("/api/v1/reservation-creation-operations") && response.request().method() === "GET");
  await resumedForm.getByRole("button", { name: "Create booking" }).click();
  const retry = await retryResponse;
  if (retry.status() !== 201) throw new Error(`recovered guest booking returned ${retry.status()}: ${await retry.text()}`);
  await recoveryQueueRefresh;
  const stillPending = await (await recoveryListRefresh).json();
  if (!stillPending.some(operation => operation.operation_token === staged.token && operation.stage === "GUEST_CREATED" && operation.guest_id === staged.body.operation.guest_id)) throw new Error(`original incomplete operation disappeared after separate booking: ${JSON.stringify(stillPending)}`);
  await page.locator(".reception-recovery-item").filter({ hasText: "F0.8 Recovery Guest" }).waitFor();
  const resumed = await retry.json();
  if (resumed.operation.stage !== "BOOKING_CREATED" || resumed.operation.guest_id !== staged.body.operation.guest_id) throw new Error(`recovery did not use original guest ${JSON.stringify(resumed)}`);
  await page.screenshot({ path: "output/playwright/f0-08-reception-recovery-desktop.png", fullPage: true });

  await page.setViewportSize({ width: 375, height: 844 });
  await page.getByRole("button", { name: "Create booking" }).click();
  const mobileForm = page.locator("form[aria-label='Create booking']");
  await mobileForm.waitFor();
  await mobileForm.locator("input[type=checkbox]").check();
  await mobileForm.getByLabel("Full name").fill("F0.8 Mobile Guest");
  await mobileForm.getByLabel("Guest email").fill("f08-mobile@example.test");
  await mobileForm.locator("input[type=date]").nth(0).fill(offsetDate(30));
  await mobileForm.locator("input[type=date]").nth(1).fill(offsetDate(32));
  const mobileAvailability = page.waitForResponse(response => response.url().includes("/api/v1/rooms/available"));
  await mobileForm.getByRole("button", { name: "Find available rooms" }).click();
  const mobileRooms = await (await mobileAvailability).json();
  if (!mobileRooms.some(room => room.id === "e2e-room-a")) throw new Error(`mobile destination absent from authoritative availability response: ${JSON.stringify(mobileRooms)}`);
  await mobileForm.getByLabel("Room").selectOption("e2e-room-a");
  const mobileCreate = page.waitForResponse(response => response.url().endsWith("/api/v1/reservation-creation-operations") && response.request().method() === "POST");
  const mobileQueueRefresh = page.waitForResponse(response => response.url().endsWith("/api/v1/front-desk/board") && response.request().method() === "GET");
  await mobileForm.getByRole("button", { name: "Create booking" }).click();
  const mobileResponse = await mobileCreate;
  if (mobileResponse.status() !== 201) throw new Error(`mobile reservation create returned ${mobileResponse.status()}: ${await mobileResponse.text()}`);
  await mobileQueueRefresh;
  const mobileResult = await mobileResponse.json();
  if (mobileResult.operation.stage !== "BOOKING_CREATED") throw new Error(`mobile reservation was not persisted: ${JSON.stringify(mobileResult)}`);
  await page.screenshot({ path: "output/playwright/f0-08-reception-recovery-mobile.png", fullPage: true });
  console.log(JSON.stringify({ desktopCreateStatus: successfulResponse.status(), createdBooking: created.booking.id, stagedStatus: staged.status, stagedGuest: staged.body.operation.guest_id, recoveryStatus: retry.status(), recoveredBooking: resumed.booking.id, originalOperationStillRecoverable: true, mobileCreateStatus: mobileResponse.status(), mobileBooking: mobileResult.booking.id, mobile: "375x844" }));
})()
)(page);
