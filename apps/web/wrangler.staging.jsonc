{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hms-cloudflare-web-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "services": [
    {
      "binding": "API",
      "service": "hms-cloudflare-api-staging"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
