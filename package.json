{
  "name": "hms-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "types:api": "wrangler types apps/api/worker-configuration.d.ts -c apps/api/wrangler.jsonc",
    "types:web": "wrangler types apps/web/worker-configuration.d.ts -c apps/web/wrangler.jsonc",
    "types:check": "npm run types:api -- --check && npm run types:web -- --check",
    "wrangler:check:api": "wrangler check -c apps/api/wrangler.jsonc",
    "wrangler:check:web": "wrangler check -c apps/web/wrangler.jsonc",
    "wrangler:dry-run": "npx wrangler deploy --dry-run -c apps/api/wrangler.jsonc && npx wrangler deploy --dry-run -c apps/web/wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
